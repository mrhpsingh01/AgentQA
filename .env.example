# AgentQA configuration. Copy to backend/.env (backend) or export in your shell (runner). Nothing here is required:
# without any LLM setting the deterministic healing levels (1, 3, 4) run offline and the LLM levels (2, 5) are skipped.

# ---- backend (backend/.env) ---------------------------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./agentqa.db        # default; or postgresql+asyncpg://user:pass@host/db
# REDIS_URL=redis://localhost:6379/0                    # optional: falls back to an in-memory cache
# JWT_SECRET_KEY=change-me-in-production-min-32-chars-long

# LLM providers for Levels 2 and 5 (set any one). Unset = those levels are skipped, never simulated.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# Any OpenAI-compatible endpoint (Groq / Cerebras / OpenRouter ...): free-tier friendly, one setting set for all
# DEFAULT_LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_ESCALATION_MODEL=                                 # Level 5 model (defaults to LLM_MODEL); LLM_ESCALATION_API_KEY likewise
# LLM_REASONING_EFFORT=low
# LLM_JSON_MODE=true
# LLM_RPM=25                                            # client-side throttle for free-tier rate limits
# NVIDIA NIM (free tier): NVIDIA_API_KEY / NVIDIA_MODEL (Level 2) and NVIDIA_ESCALATION_API_KEY / NVIDIA_ESCALATION_MODEL (Level 5)
# HEALING_CONFIDENCE_THRESHOLD=0.70                     # repairs below this are refused
# LLM_COST_PER_MTOK_INPUT=0.30                          # USD per million tokens: set to your model's list price
# LLM_COST_PER_MTOK_OUTPUT=2.50

# ---- runner (shell environment) ----------------------------------------------------------------------------
# AGENTQA_BROWSER_CHANNEL=chrome        # reuse an installed browser instead of Playwright's bundled Chromium
# AGENTQA_HEALING=on                    # off = behave like plain Playwright (the benchmark baseline)
# AGENTQA_STRICT=0                      # 1 = Level 4 also needs word overlap with the original label
# AGENTQA_RETRY_MS=800                  # Level 1 retry window
# AGENTQA_MIN_CONFIDENCE=0.70
# AGENTQA_STORE_DIR=.agentqa            # where element fingerprints are remembered between runs
# AGENTQA_REPORT=agentqa-report.json    # machine-readable report (input of scripts/pr_comment.py)
# AGENTQA_BACKEND_URL=http://localhost:8000   # enables the verified cache and the LLM levels
# AGENTQA_API_KEY=                            # X-API-Key created via POST /api/v1/auth/api-keys

# ---- dashboard ----------------------------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_MODE=true            # render the bundled real demo/benchmark results, no backend needed
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
