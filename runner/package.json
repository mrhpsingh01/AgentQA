{
  "name": "agentqa-runner",
  "version": "1.0.0",
  "description": "AgentQA Playwright runner: self-healing ladder, guardrails, assertion enforcement and reporter",
  "main": "dist/executor.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p .",
    "test": "playwright test",
    "demo": "playwright test -c demo/playwright.config.ts",
    "bench": "playwright test -c bench/playwright.config.ts",
    "run:test": "ts-node src/executor.ts"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
